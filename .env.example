DATABASE_URL=postgresql://linkbase:linkbase@localhost:5432/linkbase
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes
APP_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PORT=3001
LOG_LEVEL=info
# 限流总开关（默认开；开发期可设 false 关闭）
# RATE_LIMIT_ENABLED=true
# 限流阈值（默认=07 §3：全局 100/15min、登录 5/min、注册 3/h；开发期可放宽）
# RATE_LIMIT_GLOBAL=100
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_REGISTER=3

# docker compose 专用（compose 内 PG 初始化）
POSTGRES_USER=linkbase
POSTGRES_PASSWORD=linkbase
POSTGRES_DB=linkbase
