  "overrides": {
    "yjs": "13.6.33",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "rolldown"
  ],
  "scripts": {
    "dev": "bun run dev:server & bun run dev:web",
    "dev:web": "cd apps/web && bun run dev",
    "dev:server": "bun --watch apps/server/src/index.ts",
    "build": "cd apps/web && bun run build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test packages apps/server",
    "test:web": "cd apps/web && bun run test",
    "check": "bun run typecheck && bun run test && bun run check-i18n",
    "check-i18n": "bun run scripts/check-i18n.mjs",
    "db:migrate": "bun run packages/database/src/migrate-cli.ts",
    "db:seed": "bun run packages/database/src/seed-cli.ts",
    "db:generate": "cd packages/database && bun run db:generate",
    "e2e": "cd apps/e2e && bun run e2e"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    }
  }
}
